# Default live music provider: browser-mediated Gemini web Music.
JEHA_MUSIC_PROVIDER=gemini_web
JEHA_GEMINI_WEB_MUSIC_MODEL_PREFERENCE=3.7 Flash

# Set only after the browser skill has downloaded and verified an audio-only MP3.
# JEHA_GEMINI_WEB_MUSIC_ARTIFACT=/absolute/path/to/downloaded.mp3
# JEHA_GEMINI_WEB_MUSIC_MODEL=<exact live picker label>
# JEHA_GEMINI_WEB_MUSIC_HANDOFF=data/asset_runs/<run-id>/music_handoff.json
# JEHA_GEMINI_WEB_MUSIC_COMMERCIAL_USE_ACK=true

# Optional explicit legacy fallback (not the default).
# JEHA_MUSIC_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=<local-only>
# ELEVENLABS_COMMERCIAL_USE_ACK=true
