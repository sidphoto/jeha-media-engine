{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JEHA M4.2 Audio Plan",
  "type": "object",
  "required": ["audio_plan_id", "render_plan_id", "video_id", "topic_id", "product", "source_bundle_hash", "target_duration_seconds", "music", "sfx_tracks", "mix", "provenance", "final_status"],
  "properties": {
    "audio_plan_id": {"type": "string", "pattern": "^AUDIO-[A-Z]+-[0-9]{6}$"},
    "render_plan_id": {"type": "string", "pattern": "^RENDER-[A-Z]+-[0-9]{6}$"},
    "video_id": {"type": "string", "pattern": "^VIDEO-[A-Z]+-[0-9]{6}$"},
    "topic_id": {"type": "string", "minLength": 1},
    "product": {"enum": ["flow_room", "moon_room", "cozy_room", "nature_room"]},
    "source_bundle_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "target_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "music": {
      "type": "object",
      "required": ["strategy", "source_asset_id", "source_content_hash", "source_duration_seconds", "crossfade_seconds", "segments", "planned_coverage_seconds", "output_trim_seconds"],
      "properties": {
        "strategy": {"enum": ["trim_only", "section_cycle_crossfade"]},
        "source_asset_id": {"type": "string", "pattern": "^MUSIC-"},
        "source_content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "source_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "section_count": {"type": "integer", "minimum": 1},
        "crossfade_seconds": {"type": "number", "minimum": 0},
        "segments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/segment"}},
        "planned_coverage_seconds": {"type": "number", "exclusiveMinimum": 0},
        "output_trim_seconds": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "sfx_tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_asset_id", "source_content_hash", "source_duration_seconds", "initial_source_offset_seconds", "crossfade_seconds", "segments", "planned_coverage_seconds", "output_trim_seconds"],
        "properties": {
          "source_asset_id": {"type": "string", "pattern": "^SFX-"},
          "source_content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "source_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
          "initial_source_offset_seconds": {"type": "number", "minimum": 0},
          "crossfade_seconds": {"type": "number", "exclusiveMinimum": 0},
          "segments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sfx_segment"}},
          "planned_coverage_seconds": {"type": "number", "exclusiveMinimum": 0},
          "output_trim_seconds": {"type": "number", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "mix": {
      "type": "object",
      "required": ["integrated_loudness_target_lufs", "true_peak_ceiling_dbtp", "sfx_gain_db", "target_basis"],
      "properties": {
        "integrated_loudness_target_lufs": {"type": "number"},
        "true_peak_ceiling_dbtp": {"type": "number"},
        "sfx_gain_db": {"type": ["number", "null"]},
        "target_basis": {"const": "JEHA internal production target"}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["claim", "audio_asset_hashes"],
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "audio_asset_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
      },
      "additionalProperties": false
    },
    "final_status": {"const": "AUDIO_PLAN_READY"}
  },
  "$defs": {
    "segment": {
      "type": "object",
      "required": ["sequence", "section_id", "source_start_seconds", "source_end_seconds", "timeline_start_seconds", "timeline_end_seconds", "crossfade_in_seconds"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "section_id": {"type": "string", "minLength": 1},
        "source_start_seconds": {"type": "number", "minimum": 0},
        "source_end_seconds": {"type": "number", "exclusiveMinimum": 0},
        "timeline_start_seconds": {"type": "number", "minimum": 0},
        "timeline_end_seconds": {"type": "number", "exclusiveMinimum": 0},
        "crossfade_in_seconds": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "sfx_segment": {
      "type": "object",
      "required": ["sequence", "source_start_seconds", "source_end_seconds", "timeline_start_seconds", "timeline_end_seconds", "crossfade_in_seconds"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "source_start_seconds": {"type": "number", "minimum": 0},
        "source_end_seconds": {"type": "number", "exclusiveMinimum": 0},
        "timeline_start_seconds": {"type": "number", "minimum": 0},
        "timeline_end_seconds": {"type": "number", "exclusiveMinimum": 0},
        "crossfade_in_seconds": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
